{
  "compilerOptions": {
    /* 访问 https://aka.ms/tsconfig 了解更多关于此文件的信息 */

    /* 项目配置 */
    // "incremental": true,                              /* 保存 .tsbuildinfo 文件以允许项目的增量编译。 */
    // "composite": true,                                /* 启用约束，使 TypeScript 项目可以通过项目引用使用。 */
    // "tsBuildInfoFile": "./.tsbuildinfo",              /* 指定 .tsbuildinfo 增量编译文件的路径。 */
    // "disableSourceOfProjectReferenceRedirect": true,  /* 禁用项目引用时优先使用源文件而非声明文件。 */
    // "disableSolutionSearching": true,                 /* 编辑时禁止在多项目引用中自动搜索解决方案。 */
    // "disableReferencedProjectLoad": true,             /* 减少 TypeScript 自动加载的项目数量。 */

    /* 语言和环境 */
    "target": "ES5", /* 设置生成的 JavaScript 语言版本，并包含兼容的库声明。 */
    "lib": [
      "ES2024"
    ], /* 指定描述目标运行时环境的一组库声明文件。 */
    // "jsx": "preserve",                                /* 指定生成的 JSX 代码格式。 */
    // "libReplacement": true,                           /* 启用库替换。 */
    // "experimentalDecorators": true,                   /* 启用对实验性装饰器的支持。 */
    // "emitDecoratorMetadata": true,                    /* 在源文件中为装饰器声明生成设计类型元数据。 */
    // "jsxFactory": "",                                 /* 指定在 React JSX 生成中使用的 JSX 工厂函数，例如 'React.createElement' 或 'h'。 */
    // "jsxFragmentFactory": "",                         /* 指定在 React JSX 生成中的 Fragment 引用，例如 'React.Fragment' 或 'Fragment'。 */
    // "jsxImportSource": "",                            /* 指定在使用 'jsx: react-jsx*' 时导入 JSX 工厂函数的模块。 */
    // "reactNamespace": "",                             /* 指定创建元素时调用的对象，仅适用于 'react' JSX 生成。 */
    // "noLib": true,                                    /* 禁用包括任何库文件，包括默认的 lib.d.ts。 */
    // "useDefineForClassFields": true,                  /* 生成符合 ECMAScript 标准的类字段。 */
    // "moduleDetection": "auto",                        /* 控制检测模块格式的方式。 */

    /* 模块 */
    "module": "commonjs", /* 指定生成的模块代码格式。 */
    "rootDir": ".", /* 指定源文件的根文件夹。 */
    // "moduleResolution": "node10",                     /* 指定 TypeScript 如何根据模块路径查找文件。 */
    "baseUrl": "./.ayame/ayame-types", /* 指定解析非相对模块名称的基本目录。 */
    // "paths": {},                                      /* 指定一组条目，用于将导入重定向到其他查找位置。 */
    // "rootDirs": [],                                   /* 允许将多个文件夹视为一个，以便解析模块。 */
    "typeRoots": [
      "./.ayame/ayame-types"
    ], /* 指定多个文件夹，作用类似 './node_modules/@types'。 */
    // "types": [],                                      /* 指定不需要显式引用的类型包名称。 */
    // "allowUmdGlobalAccess": true,                     /* 允许从模块中访问 UMD 全局变量。 */
    // "moduleSuffixes": [],                             /* 指定解析模块时搜索的文件名后缀列表。 */
    // "allowImportingTsExtensions": true,               /* 允许导入带有 TypeScript 扩展名的文件。 */
    // "rewriteRelativeImportExtensions": true,          /* 在输出文件中重写相对导入路径中的 '.ts'、'.tsx' 等文件扩展名。 */
    // "resolvePackageJsonExports": true,                /* 解析 package.json 文件中的 'exports' 字段。 */
    // "resolvePackageJsonImports": true,                /* 解析 package.json 文件中的 'imports' 字段。 */
    // "customConditions": [],                           /* 除默认条件外，添加额外的解析条件。 */
    // "noUncheckedSideEffectImports": true,             /* 检查具有副作用的导入。 */
    // "resolveJsonModule": true,                        /* 允许导入 .json 文件。 */
    // "allowArbitraryExtensions": true,                 /* 允许导入任何扩展名的文件，前提是存在声明文件。 */
    // "noResolve": true,                                /* 禁止 'import'、'require' 或 '<reference>' 扩展文件数量。 */

    /* JavaScript 支持 */
    // "allowJs": true,                                  /* 允许 JavaScript 文件成为项目的一部分。 */
    // "checkJs": true,                                  /* 在 JavaScript 文件中启用类型检查。 */
    // "maxNodeModuleJsDepth": 1,                        /* 指定检查 node_modules 中 JavaScript 文件的最大深度，仅适用于 'allowJs'。 */

    /* 输出 */
    // "declaration": true,                              /* 从 TypeScript 和 JavaScript 文件生成 .d.ts 声明文件。 */
    // "declarationMap": true,                           /* 为 .d.ts 文件生成 source map 文件。 */
    // "emitDeclarationOnly": true,                      /* 仅生成 .d.ts 文件，不生成 JavaScript 文件。 */
    // "sourceMap": true,                                /* 为生成的 JavaScript 文件创建 source map 文件。 */
    // "inlineSourceMap": true,                          /* 在生成的 JavaScript 文件中嵌入 source map 文件。 */
    // "noEmit": true,                                   /* 禁止生成任何输出文件。 */
    // "outFile": "./",                                  /* 指定将所有输出捆绑到一个 JavaScript 文件中。 */
    // "outDir": "./",                                   /* 指定所有输出文件的输出目录。 */
    "removeComments": true, /* 禁止在输出文件中包含注释。 */
    // "importHelpers": true,                            /* 允许从 tslib 中引入帮助函数，而不是每个文件都生成。 */
    // "downlevelIteration": true,                       /* 生成兼容但更冗长的迭代代码。 */
    // "sourceRoot": "",                                 /* 为调试器指定源代码路径。 */
    // "mapRoot": "",                                    /* 为调试器指定 source map 文件的位置。 */
    // "inlineSources": true,                            /* 在生成的 JavaScript 文件的 source map 中嵌入源代码。 */
    // "emitBOM": true,                                  /* 在输出文件开头生成 UTF-8 BOM（字节顺序标记）。 */
    // "newLine": "crlf",                                /* 指定输出文件的换行符类型。 */
    // "stripInternal": true,                            /* 禁用生成带 '@internal' JSDoc 注释的声明。 */
    // "noEmitHelpers": true,                            /* 禁止生成内置帮助函数（如 '__extends'）。 */
    // "noEmitOnError": true,                            /* 在存在类型检查错误时禁止生成文件。 */
    // "preserveConstEnums": true,                       /* 保留 'const enum' 声明，不将其转换为内联。 */
    // "declarationDir": "./",                           /* 指定生成的声明文件输出目录。 */

    /* 兼容性约束 */
    // "isolatedModules": true,                          /* 确保每个文件都可以安全地独立编译。 */
    // "verbatimModuleSyntax": true,                     /* 保持导入/导出的语法与原始代码一致。 */
    // "isolatedDeclarations": true,                     /* 要求为导出内容添加足够的注释，以便生成声明文件。 */
    // "erasableSyntaxOnly": true,                       /* 禁止使用非 ECMAScript 规范的语法。 */
    // "allowSyntheticDefaultImports": true,             /* 允许在没有默认导出的模块中使用默认导入。 */
    "esModuleInterop": true, /* 生成额外的 JavaScript 代码以支持 CommonJS 模块导入。 */
    // "preserveSymlinks": true,                         /* 禁止解析符号链接的真实路径。 */
    "forceConsistentCasingInFileNames": true, /* 强制文件名导入大小写一致。 */

    /* 类型检查 */
    "strict": true, /* 启用所有严格类型检查选项。 */
    "skipLibCheck": true /* 跳过所有 .d.ts 文件的类型检查。 */
  },
  "include": [
    ".ayame-types/*.d.ts",
    "./**/*.js",
    "./**/*.ts",
    null
  ]
}
