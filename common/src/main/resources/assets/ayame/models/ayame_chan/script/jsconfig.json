{
  "compilerOptions": {
    "target": "ES5",
    "lib": [
      "ES5"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitThis": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node10",
    "typeRoots": [
      "types/@types"
    ],
    "baseUrl": "."
  },
  "include": [
    "./types/**/*.d.ts",
    "./**/*.js"
  ],
  "exclude": []
}